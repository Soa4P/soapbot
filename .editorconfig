root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# The repository is developed on Windows too; without `end_of_line = lf` a Windows
# editor writes CRLF, and the first `git diff` after that rewrites every line of the
# file, hiding the actual change.
[*.{js,ts,mjs,cjs}]
indent_size = 2

[*.{json,yml,yaml,css,html,vue,md}]
indent_size = 2

[*.md]
# Trailing whitespace is a hard line break in Markdown; trimming it silently joins
# lines that were meant to break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
