# Browser-automation scratch. `playwright-cli` writes snapshots and screenshots here
# during panel verification; they are session artifacts, not sources.
.playwright-cli/

# Scratch files used while preparing a commit (message drafts, CI log dumps, one-off
# probes). `git add -A` swept a message draft into a commit once; these are never sources.
.msg.tmp
# Advisory lock sidecar created by `config_write.env_transaction` next to the .env it
# serialises. The lock is a kernel-owned handle, so the empty file is safe to share —
# but it is never source and must not be committed.
*.env.lock
.env.lock
.ci-*.txt
.ci-*.log
.ci-*.json
.ci-*.py
.pt-out*.txt
.oracle-*.txt
.oracle-*.ps1
.verify-*.py

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
# Build-output verification droppings. The `dist/` rule above does not match this name
# because it is a different directory, so a wheel dropped here was showing up as an
# untracked 369 KB binary in `git status` — noise that makes the real diff harder to read.
dist_check/
secrets/
.mypy_cache/
.ruff_cache/
.pytest_cache/
# Explicit ``--basetemp`` targets used by local runs. Without this they are ordinary
# untracked directories, and ``git add -A`` swept ~19k lines of test fixtures into a
# commit that was only supposed to touch dispatch and shutdown code.
#
# Both spellings are listed because both get used: the hyphenated one came from a
# one-off `--basetemp=.pytest-tmp` while chasing the CI hang, and it left 28k files
# behind that the underscore-only pattern did not cover.
.pytest_tmp*/
.pytest-tmp/

# Node / frontend
node_modules/
webui/.vite/
*.local

# Tauri desktop shell. `Cargo.lock` is *not* ignored: this is an application, and a
# floating dependency set is how a shell that compiled last month stops compiling.
desktop/src-tauri/target/
desktop/src-tauri/gen/
# Frozen backend the shell will spawn (PyInstaller onefile, ~46 MiB), its work
# directory, and the copy staged into the Tauri bundle. Build artefacts, not sources:
# `desktop/sidecar/build.py` reproduces all three.
desktop/sidecar/dist/
build/
# The directory itself is committed (an empty `.gitkeep`), because Tauri validates
# `bundle.resources` at build-script time: a missing directory fails `cargo check`, and
# CI checks the shell without producing the 46 MiB sidecar.
desktop/src-tauri/binaries/*
!desktop/src-tauri/binaries/.gitkeep
# The built panel ships inside the Python package, so it must not be gitignored:
# the Docker image builds a wheel from src/ alone and would otherwise have no UI.
!src/soapbot/webui/dist/
!src/soapbot/webui/dist/**

# Runtime data
data/
*.db
*.db-journal
*.db-wal
*.db-shm
logs/
uploads/
cookies.txt
*.session

# Secrets
.env
.env.*
!.env.example
keys/
*.pem
*.key

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# CodeBuddy plan artifacts
.codebuddy/

# Scratch file used to pass a multi-line commit message on Windows, where PowerShell
# mangles a quoted message containing straight quotes into a path error.
.git-commit-msg.tmp

# Throwaway drivers written while testing a host (never part of the project).
.tmp-*

# Redirect targets for command output (`.tmp_full.txt` and friends). The dash and the
# underscore are both in use on this machine, and `git add -A` picked one up once.
.tmp_*

# Watchdog output from tests/conftest.py. Written only when a test exceeds its
# deadline, and printed by CI at that point; it is a diagnostic, not a source file.
pytest-hang-dump.log
.zcode/
.mimosa/
