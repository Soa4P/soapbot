{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soapbot",
  "version": "0.1.0",
  "identifier": "dev.soapbot.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "soapbot 控制台",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src http://127.0.0.1:6185; frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "soapbot 控制台桌面壳",
    "longDescription": "打开本机 soapbot 控制台。后端未启动时给出启动命令，而不是一块白屏。"
  }
}
