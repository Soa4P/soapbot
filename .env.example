# soapbot environment template.
#
# Copy to `.env` and edit. Every value here is read by `soapbot.config.Settings`
# with the `SOAPBOT_` prefix, so `.env` lines and real environment variables are
# interchangeable — a container should use real environment variables or, better,
# mounted files (see MASTER_KEY_FILE below).
#
# Nothing in this file is a secret you should commit. `.env` is gitignored.

# ---------------------------------------------------------------- server
# Loopback by default. Setting this to 0.0.0.0 exposes the management API, which
# includes a plugin-load endpoint — i.e. remote code execution — so it also
# requires authentication (see INIT_TOKEN below, and `soapbot doctor` will warn).
SOAPBOT_HOST=127.0.0.1
SOAPBOT_PORT=6185

# ---------------------------------------------------------------- storage
# Writable volume: SQLite database, logs, uploads, plugins, avatars.
SOAPBOT_DATA_DIR=./data

# Runtime configuration (providers / adapters / mcp) — rewritten by the panel, so it has
# to live on the writable volume. Left unset on purpose: it then sits under DATA_DIR
# (data/config). A *relative* value here resolves against the process working directory,
# which under systemd is the checkout — that turns the shipped template into the file
# being edited, and the next `git pull` undoes every provider that was configured.
# SOAPBOT_CONFIG_DIR=/absolute/path/config

# ---------------------------------------------------------------- security
# Fernet key used to encrypt provider API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to auto-generate into <data>/master.key on first start.
SOAPBOT_MASTER_KEY=

# Preferred over MASTER_KEY in any container: an environment variable is visible
# to `docker inspect` and /proc/<pid>/environ, a mode-0400 file is not.
# SOAPBOT_MASTER_KEY_FILE=/run/secrets/soapbot_master_key

# One-time bootstrap token. Empty = generate on first start and write it to
# data/init_token.txt (0600). An unused token survives restarts unchanged; once
# redeemed the file is deleted and login stays closed. `soapbot token` reprints it,
# `soapbot token --reset` mints a new one (then restart the service).
SOAPBOT_INIT_TOKEN=

# Signing key for WebUI session tokens. Empty = auto-generate.
SOAPBOT_JWT_SECRET=
SOAPBOT_JWT_TTL_HOURS=72

# ---------------------------------------------------------------- authority
# These lists are the ONLY source of bot privileges. Nothing in a chat message
# can add to them. Comma-separated QQ numbers.
SOAPBOT_OWNER_IDS=123456789
SOAPBOT_ADMIN_IDS=
SOAPBOT_MEMBER_IDS=
# Convenience for a single-operator install; honoured only when OWNER_IDS is empty.
SOAPBOT_FIRST_RUN_OWNER=

# Honour an owner/admin role claimed by the *protocol payload*. Off by default and
# it should stay off: the role field is attacker-influenced on any transport that
# is not authenticated end to end.
SOAPBOT_TRUST_PROTOCOL_ROLES=false

# ---------------------------------------------------------------- streaming
# Deliver replies sentence by sentence while the model is still generating.
# Off by default: it changes what a group receives from one message to several, and
# that is a visible behaviour, not an implementation detail. The adapter must also
# declare PROGRESSIVE (OneBot does; the official QQ passive-reply window does not).
SOAPBOT_STREAM_REPLY=false
# Cut a runaway sentence at the nearest comma/space inside this budget.
SOAPBOT_STREAM_CHUNK_CHARS=80
# Send whatever has accumulated if no sentence is complete after this many seconds.
# Without it a slow model makes time-to-first-message equal to total latency.
SOAPBOT_STREAM_FIRST_PACKET_DEADLINE=1.2
# Minimum seconds between two progressive messages to the same group.
SOAPBOT_STREAM_SEND_INTERVAL=0.35

# ---------------------------------------------------------------- voice
# Transcribe inbound voice messages. Costs one provider call per voice note, and it
# turns audio the bot was not listening to into text it will then act on — hence off
# by default. Requires a provider that declares the TRANSCRIBE slot; without one the
# message degrades to a visible "[语音]" placeholder, never to invented words.
SOAPBOT_VOICE_ENABLED=false
# Deliver replies as voice messages. Needs the optional extra:
#   pip install 'soapbot[voice]'
# Without it replies go out as text and the reason is logged at INFO.
SOAPBOT_VOICE_TTS_ENABLED=false
SOAPBOT_VOICE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# Cap on downloaded audio, applied while reading rather than after.
SOAPBOT_VOICE_MAX_BYTES=8388608
SOAPBOT_VOICE_LANGUAGE=zh
# Media endpoints on the bot's own network that are allowed to serve audio.
# Needed in the usual deployment: NapCat serves record files from its own HTTP port,
# so the segment URL is http://127.0.0.1:3000/... and the public-address rule would
# otherwise refuse every voice message. Comma-separated; empty = strict.
# SOAPBOT_VOICE_ALLOW_HOSTS=127.0.0.1

# ---------------------------------------------------------------- QQ 接入
# 官方机器人（推荐）：adapters.yaml 里写 `kind: qq_official` + `app_secret: env:QQ_BOT_SECRET`
# AppSecret 只从环境/密钥文件读取，不要写进 YAML 或提交到仓库。
# QQ_BOT_SECRET=
# 自建 OneBot 协议端：协议端自己的 access token，对应 adapters.yaml 的 access_token。
# ONEBOT_ACCESS_TOKEN=

# OneBot 11 网关（可选）：把官方机器人暴露给 OneBot 客户端。token 为空时拒绝启动。
SOAPBOT_ONEBOT_GATEWAY_ENABLED=false
# SOAPBOT_ONEBOT_GATEWAY_HOST=127.0.0.1
# SOAPBOT_ONEBOT_GATEWAY_PORT=6700
# SOAPBOT_ONEBOT_GATEWAY_PATH=/onebot/v11/ws
# SOAPBOT_ONEBOT_GATEWAY_TOKEN=

# ------------------------------------------------------------ chat archive
# Which clients may reach /api/chat/*. With all three off those routes 404, as if
# the deployment never had them. Web stays on because it is how you check the
# archive before shipping a mobile build; app and desktop are binaries installed on
# machines you may not control, so enabling them is an explicit decision.
SOAPBOT_CHAT_WEB_ENABLED=true
SOAPBOT_CHAT_APP_ENABLED=false
SOAPBOT_CHAT_DESKTOP_ENABLED=false
# Let authorised accounts CONVERSE with the bot from the web/mobile ends. This turns
# web:private:account-<id> sessions into a second message source (QQ stays the source
# for qq:* sessions). Off by default; even when on, an account can only talk in a
# session the owner granted it (page 14 / POST /api/accounts/memberships), and every
# message pays the same pipeline tolls as a QQ message.
SOAPBOT_CHAT_TALK_ENABLED=false

# ---------------------------------------------------------------- language
# The language the bot speaks *in a group*: refusals, voice labels. Does not affect
# the console, which follows each browser (page 12 switches it). A persona card can
# override this per group with its `locale` field, so an English group does not force
# every other group to change.
SOAPBOT_DEFAULT_LOCALE=zh-CN

# ---------------------------------------------------------------- access control
# Groups the bot may answer in. Empty = any group it is invited to.
SOAPBOT_GROUP_ALLOWLIST=
# Groups to refuse even if the allowlist is empty.
SOAPBOT_GROUP_BLACKLIST=
# Users refused everywhere.
SOAPBOT_USER_BLACKLIST=

# Private messages. Empty means NOBODY, not anybody: a DM is a direct line into
# persona + memory + RAG with no other participants to notice.
SOAPBOT_PRIVATE_ALLOWLIST=
# Explicit opt-in for "anyone may DM the bot".
SOAPBOT_ALLOW_UNKNOWN_PRIVATE=false

# Allow plugins marked `trust: untrusted` to hold sensitive capabilities. Turning
# this on is equivalent to "run code from anyone in-process".
SOAPBOT_ALLOW_UNTRUSTED_PLUGINS=false
# Maximum number of resident plugin worker processes (one per plugin). Must be
# between 1 and 64; 0 is rejected on purpose -- this is a security boundary, not a
# throughput dial. Raise it only after sizing memory: each worker has its own
# interpreter, pipe pair and address-space ceiling.
SOAPBOT_MAX_PLUGIN_WORKERS=16

# ---------------------------------------------------------------- runtime
# Build the bot runtime (pipeline + adapters) inside the app process. Off is for
# HTTP-only deployments that drive the API from elsewhere.
SOAPBOT_ENABLE_RUNTIME=true
SOAPBOT_SCHEDULER_TICK_SECONDS=30

# ---------------------------------------------------------------- optional features
# Both are opt-in so that enabling them is a deliberate operator decision.
SOAPBOT_ENABLE_BUDGET=false
SOAPBOT_BUDGET_CURRENCY=CNY
SOAPBOT_BUDGET_PERIOD=month
# Integer minor units (fen). ¥500.00 per period, ¥100.00 per request.
SOAPBOT_BUDGET_PERIOD_CAP_MINOR=50000
SOAPBOT_BUDGET_PER_REQUEST_CAP_MINOR=10000

SOAPBOT_ENABLE_BILIBILI=false
SOAPBOT_BILIBILI_TIER=l1
SOAPBOT_BILIBILI_RATE_PER_MINUTE=12
SOAPBOT_BILIBILI_MAX_COMMENTS=8

# ---------------------------------------------------------------- outbound HTTP
# One pooled client for the whole process. The defaults are tuned for a chat bot:
# fail fast on a dead host, reuse the connection between two messages in the same
# conversation, and never let a burst open one socket per reply.
#
# Connect and read are separate on purpose. With one flat timeout, discovering that
# an endpoint is unreachable costs the entire completion budget before failover.
SOAPBOT_OUTBOUND_CONNECT_TIMEOUT=5
SOAPBOT_OUTBOUND_READ_TIMEOUT=60
SOAPBOT_OUTBOUND_WRITE_TIMEOUT=10
# Short: queueing behind a saturated pool for a minute is indistinguishable from a hang.
SOAPBOT_OUTBOUND_POOL_TIMEOUT=5
SOAPBOT_OUTBOUND_MAX_CONNECTIONS=32
SOAPBOT_OUTBOUND_MAX_KEEPALIVE=16
# Longer than the gap between two messages, so the second one reuses the TLS session.
SOAPBOT_OUTBOUND_KEEPALIVE_EXPIRY=30
# Redirects are never followed automatically; each hop is re-validated.
SOAPBOT_OUTBOUND_MAX_REDIRECTS=3
# The default identifies the library, not the deployment, which makes this bot's
# traffic indistinguishable from any httpx client on a provider's abuse dashboard.
# Set it to something that names your instance.
SOAPBOT_OUTBOUND_USER_AGENT=soapbot/0.1 (+https://github.com/soapbot/soapbot)

# ---------------------------------------------------------------- logging
SOAPBOT_LOG_LEVEL=INFO
# JSON lines for machines; set false for a human reading a terminal.
SOAPBOT_LOG_JSON=true
# Size of the in-process ring buffer the WebUI tail shows.
SOAPBOT_LOG_RING_SIZE=2000
# Provider calls slower than this are logged at WARNING; faster ones are DEBUG.
SOAPBOT_SLOW_CALL_MS=3000

# ------------------------------------------------------- request boundary
# Loopback clients may read, but need a credential to change state. Turning this
# off restores "local means owner"; the test suite is the only place that does.
SOAPBOT_STRICT_LOOPBACK_AUTH=true
# Set true behind an HTTPS reverse proxy. Over plain loopback HTTP a Secure
# cookie is never sent back and login looks like a no-op.
SOAPBOT_COOKIE_SECURE=false
# Abort startup when an enabled adapter cannot be constructed. Set false only
# for a panel-only install that must come up with a broken optional adapter.
SOAPBOT_STRICT_STARTUP=true
# Ceiling applied before any pattern runs over user- or operator-supplied text.
SOAPBOT_MAX_REGEX_INPUT_CHARS=20000

# ------------------------------------------------------- persona growth
# Let the model rewrite a persona card and take effect immediately. Every write
# keeps a restorable version; set false to make growth calls fail instead.
SOAPBOT_PERSONA_GROWTH_ENABLED=true
# Rendered-card ceiling for one growth write.
SOAPBOT_PERSONA_GROWTH_MAX_CHARS=2000
# Model writes allowed per card per hour; baselines and rollbacks do not count.
SOAPBOT_PERSONA_GROWTH_PER_HOUR=6

# ------------------------------------------------------- memory layers
# How many L4 self-notes to keep; the oldest is evicted, not the newest.
SOAPBOT_SELF_NOTES_LIMIT=40
# Compaction needs BOTH gates: quiet for this many minutes...
SOAPBOT_COMPACTION_IDLE_MINUTES=30
# ...and an estimated context at least this large. 0 disables either gate.
SOAPBOT_COMPACTION_TOKEN_THRESHOLD=6000
# Recent timeline events shown to the model.
SOAPBOT_TIMELINE_WINDOW=10

SOAPBOT_DEFAULT_TIMEZONE=Asia/Shanghai
