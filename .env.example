# soapbot environment template.
#
# Copy to `.env` and edit. Every value here is read by `soapbot.config.Settings`
# with the `SOAPBOT_` prefix, so `.env` lines and real environment variables are
# interchangeable — a container should use real environment variables or, better,
# mounted files (see MASTER_KEY_FILE below).
#
# Nothing in this file is a secret you should commit. `.env` is gitignored.

# ---------------------------------------------------------------- server
# Loopback by default. Setting this to 0.0.0.0 exposes the management API, which
# includes a plugin-load endpoint — i.e. remote code execution — so it also
# requires authentication (see INIT_TOKEN below, and `soapbot doctor` will warn).
SOAPBOT_HOST=127.0.0.1
SOAPBOT_PORT=6185

# ---------------------------------------------------------------- storage
# Writable volume: SQLite database, logs, uploads, plugins, avatars.
SOAPBOT_DATA_DIR=./data

# Configuration that the service never rewrites. Mount read-only in a container.
SOAPBOT_CONFIG_DIR=./config

# ---------------------------------------------------------------- security
# Fernet key used to encrypt provider API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to auto-generate into <data>/master.key on first start.
SOAPBOT_MASTER_KEY=

# Preferred over MASTER_KEY in any container: an environment variable is visible
# to `docker inspect` and /proc/<pid>/environ, a mode-0400 file is not.
# SOAPBOT_MASTER_KEY_FILE=/run/secrets/soapbot_master_key

# One-time bootstrap token printed on first start. Empty = auto-generate.
# Needed to log into the WebUI; `soapbot token` reprints it.
SOAPBOT_INIT_TOKEN=

# Signing key for WebUI session tokens. Empty = auto-generate.
SOAPBOT_JWT_SECRET=
SOAPBOT_JWT_TTL_HOURS=72

# ---------------------------------------------------------------- authority
# These lists are the ONLY source of bot privileges. Nothing in a chat message
# can add to them. Comma-separated QQ numbers.
SOAPBOT_OWNER_IDS=123456789
SOAPBOT_ADMIN_IDS=
SOAPBOT_MEMBER_IDS=
# Convenience for a single-operator install; honoured only when OWNER_IDS is empty.
SOAPBOT_FIRST_RUN_OWNER=

# Honour an owner/admin role claimed by the *protocol payload*. Off by default and
# it should stay off: the role field is attacker-influenced on any transport that
# is not authenticated end to end.
SOAPBOT_TRUST_PROTOCOL_ROLES=false

# ---------------------------------------------------------------- streaming
# Deliver replies sentence by sentence while the model is still generating.
# Off by default: it changes what a group receives from one message to several, and
# that is a visible behaviour, not an implementation detail. The adapter must also
# declare PROGRESSIVE (OneBot does; the official QQ passive-reply window does not).
SOAPBOT_STREAM_REPLY=false
# Cut a runaway sentence at the nearest comma/space inside this budget.
SOAPBOT_STREAM_CHUNK_CHARS=80
# Send whatever has accumulated if no sentence is complete after this many seconds.
# Without it a slow model makes time-to-first-message equal to total latency.
SOAPBOT_STREAM_FIRST_PACKET_DEADLINE=1.2
# Minimum seconds between two progressive messages to the same group.
SOAPBOT_STREAM_SEND_INTERVAL=0.35

# ---------------------------------------------------------------- voice
# Transcribe inbound voice messages. Costs one provider call per voice note, and it
# turns audio the bot was not listening to into text it will then act on — hence off
# by default. Requires a provider that declares the TRANSCRIBE slot; without one the
# message degrades to a visible "[语音]" placeholder, never to invented words.
SOAPBOT_VOICE_ENABLED=false
# Deliver replies as voice messages. Needs the optional extra:
#   pip install 'soapbot[voice]'
# Without it replies go out as text and the reason is logged at INFO.
SOAPBOT_VOICE_TTS_ENABLED=false
SOAPBOT_VOICE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# Cap on downloaded audio, applied while reading rather than after.
SOAPBOT_VOICE_MAX_BYTES=8388608
SOAPBOT_VOICE_LANGUAGE=zh

# ---------------------------------------------------------------- access control
# Groups the bot may answer in. Empty = any group it is invited to.
SOAPBOT_GROUP_ALLOWLIST=
# Groups to refuse even if the allowlist is empty.
SOAPBOT_GROUP_BLACKLIST=
# Users refused everywhere.
SOAPBOT_USER_BLACKLIST=

# Private messages. Empty means NOBODY, not anybody: a DM is a direct line into
# persona + memory + RAG with no other participants to notice.
SOAPBOT_PRIVATE_ALLOWLIST=
# Explicit opt-in for "anyone may DM the bot".
SOAPBOT_ALLOW_UNKNOWN_PRIVATE=false

# Allow plugins marked `trust: untrusted` to hold sensitive capabilities. Turning
# this on is equivalent to "run code from anyone in-process".
SOAPBOT_ALLOW_UNTRUSTED_PLUGINS=false

# ---------------------------------------------------------------- runtime
# Build the bot runtime (pipeline + adapters) inside the app process. Off is for
# HTTP-only deployments that drive the API from elsewhere.
SOAPBOT_ENABLE_RUNTIME=true
SOAPBOT_SCHEDULER_TICK_SECONDS=30

# ---------------------------------------------------------------- optional features
# Both are opt-in so that enabling them is a deliberate operator decision.
SOAPBOT_ENABLE_BUDGET=false
SOAPBOT_BUDGET_CURRENCY=CNY
SOAPBOT_BUDGET_PERIOD=month
# Integer minor units (fen). ¥500.00 per period, ¥100.00 per request.
SOAPBOT_BUDGET_PERIOD_CAP_MINOR=50000
SOAPBOT_BUDGET_PER_REQUEST_CAP_MINOR=10000

SOAPBOT_ENABLE_BILIBILI=false
SOAPBOT_BILIBILI_TIER=l1
SOAPBOT_BILIBILI_RATE_PER_MINUTE=12
SOAPBOT_BILIBILI_MAX_COMMENTS=8

# ---------------------------------------------------------------- logging
SOAPBOT_LOG_LEVEL=INFO
# JSON lines for machines; set false for a human reading a terminal.
SOAPBOT_LOG_JSON=true
# Size of the in-process ring buffer the WebUI tail shows.
SOAPBOT_LOG_RING_SIZE=2000

SOAPBOT_DEFAULT_TIMEZONE=Asia/Shanghai
