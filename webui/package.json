{
  "name": "soapbot-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:api": "node scripts/check-api-paths.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:i18n && npm run check:api && npm run test && npm run build"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  }
}
